<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة وتحليل نتائج الطلاب</title>
</head>
<body>
    <h1>نظام إدارة وتحليل نتائج الطلاب</h1>
    <script>
        // 1. هيكلة بيانات الطالب (Class & Constructor)
        class Student {
            constructor(id, name, grades, attendance) {
                this.id = id;
                this.name = name;
                this.grades = grades; // مصفوفة درجات 3 مواد
                this.attendance = attendance; // نسبة الحضور
            }

            // 2. دوال التحليل الأكاديمي (Methods)
            // دالة حساب المتوسط باستخدام reduce
            calculateAverage() {
                const sum = this.grades.reduce((total, grade) => total + grade, 0);
                return sum / this.grades.length;
            }

            // دالة التقدير باستخدام قاعدة الشروط (if/else)
            getGrade(average) {
                if (average >= 85) return 'A';
                else if (average >= 75) return 'B';
                else if (average >= 65) return 'C';
                else if (average >= 50) return 'D';
                else if (average >= 40) return 'E';
                else return 'F';
            }

            // دالة النتيجة النهائية بالتحقق من الشرطين باستخدام (&&)
            getFinalStatus() {
                const average = this.calculateAverage();
                if (average >= 50 && this.attendance >= 75) {
                    return "ناجح";
                } else {
                    return "يحتاج مراجعة";
                }
            }
        }

        // 3. نظام تشغيل الجامعة (Objects Array)
        const studentsList = [];

        // تخليق 4 كائنات (طلاب) ببيانات مختلفة تشمل طلاب متعثرين (متوسطهم بين 40 و 49)
        const s1 = new Student(101, "أحمد محمد", [42, 45, 48], 80); // متوسطه 45 (متعثر) وحضور 80%
        const s2 = new Student(102, "سارة علي", [85, 90, 95], 95);  // متفوقة (ناجحة)
        const s3 = new Student(103, "منى أحمد", [40, 42, 44], 70);  // متوسطه 42 (متعثر) وحضور أقل من 75%
        const s4 = new Student(104, "كريم محمود", [55, 60, 65], 85); // متوسط مقبول (ناجح)

        studentsList.push(s1, s2, s3, s4);

        // 4. لجنة الرأفة (Array Methods)
        // الاستخراج: باستخدام filter للطلاب الذين متوسطاتهم بين 40 و 49
        const strugglingStudents = studentsList.filter(student => {
            const avg = student.calculateAverage();
            return avg >= 40 && avg <= 49;
        });

        // المعالجة: باستخدام map لإضافة 5 درجات رأفة كدعم لمتوسط الطلاب المتعثرين
        const upgradedAverages = strugglingStudents.map(student => {
            return student.calculateAverage() + 5;
        });

        // التحليل: باستخدام reduce لجمع المتوسطات الجديدة بعد التعديل
        const totalUpgradedAverages = upgradedAverages.reduce((sum, avg) => sum + avg, 0);

        // متوسط الرأفة العام مع إضافة "درع حماية" برمجياً لمنع القسمة على صفر
        const graceCount = upgradedAverages.length;
        const overallGraceAverage = graceCount > 0 ? (totalUpgradedAverages / graceCount) : 0;

        // 5. المخرجات (Console Logging)
        console.log("--- تقرير الطلاب في المصفوفة الرئيسية ---");
        studentsList.forEach(student => {
            const avg = student.calculateAverage();
            const grade = student.getGrade(avg);
            const status = student.getFinalStatus();
            console.log(`الاسم: ${student.name} | المتوسط: ${avg.toFixed(1)} | التقدير: ${grade} | النتيجة: ${status}`);
        });

        console.log("--- مصفوفة الطلاب المتعثرين الذين شملتهم الرأفة ---");
        console.log(strugglingStudents);
        
        console.log("--- متوسط درجات الطلاب المتعثرين بعد التعديل ---");
        console.log(overallGraceAverage.toFixed(1));
    </script>
</body>
</html>
